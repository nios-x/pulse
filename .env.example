# --- Required ---
DATABASE_URL=postgres://pulse:pulse@localhost:5432/pulse
# Public URL of the app (used in emails, QR codes and share links)
APP_URL=http://localhost:3000
# 64 hex characters. Encrypts record files (AES-256-GCM). Generate: openssl rand -hex 32
ENCRYPTION_KEY=
# Bearer secret for /api/cron/* (Vercel Cron sends it automatically when set)
CRON_SECRET=

# --- Email (nodemailer) ---
# Pick one. With none set, emails are rendered and logged (email_log table + console), not sent.
# SMTP_URL=smtps://user:app-password@smtp.gmail.com:465
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_TRANSPORT=ethereal      # free test inbox, prints a preview URL per email
MAIL_FROM="Pulse Family Health <no-reply@your-domain.com>"

# --- AI (optional) ---
# Prescription scanner + triage phrasing. Without a key: scanner shows a labelled sample, triage uses safety rules only.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# --- Local scheduler (optional, self-hosting) ---
# LOCAL_CRON=1   # runs the reminder sweep every 5 minutes inside the Next.js server
