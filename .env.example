DATABASE_URL=postgres://pulse:pulse@localhost:5433/pulse

# Web Push (phase 10). Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:team@pulse.example
# Bearer secret the scheduler sends to /api/cron/reminders
CRON_SECRET=

# Family calls (phase 11). The signaling server needs the same SIGNALING_SECRET.
SIGNALING_SECRET=
NEXT_PUBLIC_SIGNALING_URL=ws://localhost:8080
STUN_URLS=stun:stun.l.google.com:19302
# Your own TURN server, so calls connect across mobile networks
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Meal photos: Gemini reads the foods in a photo (optional; without a key only the food chips show)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
