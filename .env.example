# --- Required ---
DATABASE_URL=postgres://pulse:pulse@localhost:5432/pulse
# Direct (non-pooled) connection for migrations, if DATABASE_URL is a pooler URL. Neon on Vercel sets this.
# DATABASE_URL_UNPOOLED=
# Public URL of the app (used in emails, QR codes and share links). On Vercel it falls back to the production domain.
APP_URL=http://localhost:3000
# 64 hex characters. Encrypts record files (AES-256-GCM). Generate: openssl rand -hex 32
ENCRYPTION_KEY=
# Bearer secret for /api/cron/* (Vercel Cron sends it automatically; also add it as a GitHub Actions secret)
CRON_SECRET=

# --- Email (nodemailer) ---
# Pick one. With none set, emails are rendered and logged (email_log table + console), not sent.
# SMTP_URL=smtps://user:app-password@smtp.gmail.com:465
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_TRANSPORT=ethereal      # free test inbox, prints a preview URL per email
MAIL_FROM="Pulse Family Health <no-reply@your-domain.com>"

# --- AI (optional) ---
# Prescription scanner + triage phrasing. Without a key: scanner shows a labelled sample, triage uses safety rules only.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# Tried in order when the main model is rate-limited or overloaded
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite
# Pulse assistant voice (Gemini TTS). Lite is tried when the main voice model is busy.
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# GEMINI_TTS_FALLBACK_MODELS=gemini-3.8-flash-lite-tts
# GEMINI_TTS_VOICE=Kore

# --- Local scheduler (optional, self-hosting) ---
# LOCAL_CRON=1   # runs the reminder sweep every 5 minutes inside the Next.js server
